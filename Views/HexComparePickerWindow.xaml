<Window x:Class="NexusProgrammer.HexComparePickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Hex Compare" Width="520" Height="180"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    Background="{DynamicResource AppBackgroundBrush}"
    Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource ThemedButtonStyle}" />
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="34" />
            <RowDefinition Height="44" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="BIOS 1" VerticalAlignment="Center" />
        <ComboBox x:Name="Bios1Combo" Grid.Row="0" Grid.Column="1" Height="24" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="BIOS 2" VerticalAlignment="Center" />
        <ComboBox x:Name="Bios2Combo" Grid.Row="1" Grid.Column="1" Height="24" />

        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
            Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="CompareButton" Width="86" Height="26" Margin="0,0,8,0"
                IsDefault="True" Click="Compare_Click">Compare</Button>
            <Button Width="78" Height="26" IsCancel="True">Cancel</Button>
        </StackPanel>
    </Grid>
</Window>
