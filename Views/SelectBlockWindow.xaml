<Window x:Class="NexusProgrammer.SelectBlockWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Select block" Width="300" Height="200"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    Background="{DynamicResource AppBackgroundBrush}"
    Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource ThemedButtonStyle}" />
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="34" />
            <RowDefinition Height="34" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="88" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Start-offset" VerticalAlignment="Center" />
        <TextBox x:Name="StartBox" Grid.Row="0" Grid.Column="1" Height="24" />

        <RadioButton x:Name="EndRadio" Grid.Row="1" Grid.Column="0" Content="End-offset"
            VerticalAlignment="Center" IsChecked="True" />
        <TextBox x:Name="EndBox" Grid.Row="1" Grid.Column="1" Height="24" />

        <RadioButton x:Name="LengthRadio" Grid.Row="2" Grid.Column="0" Content="Length"
            VerticalAlignment="Center" />
        <TextBox x:Name="LengthBox" Grid.Row="2" Grid.Column="1" Height="24" />

        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
            Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Width="76" Height="26" IsDefault="True" Margin="0,0,8,0"
                Click="Ok_Click">OK</Button>
            <Button Width="76" Height="26" IsCancel="True">Cancel</Button>
        </StackPanel>
    </Grid>
</Window>