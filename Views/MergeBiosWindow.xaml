<Window x:Class="NexusProgrammer.MergeBiosWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Merge BIOS" Width="520" Height="230" MinWidth="440" MinHeight="230"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResize"
    Background="{DynamicResource AppBackgroundBrush}"
    Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource ThemedButtonStyle}" />
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TabControl VerticalAlignment="Stretch">
            <TabItem Header="Merge BIOS">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="86" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="58" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="BIOS 1"
                        VerticalAlignment="Center" />
                    <ComboBox x:Name="Bios1Combo" Grid.Row="0" Grid.Column="1"
                        Height="24" Margin="0,0,8,6" />
                    <Button x:Name="ClearButton" Grid.Row="0" Grid.Column="2"
                        Height="24" Margin="0,0,0,6" Click="Clear_Click">X</Button>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="BIOS 2"
                        VerticalAlignment="Center" />
                    <ComboBox x:Name="Bios2Combo" Grid.Row="1" Grid.Column="1"
                        Height="24" Margin="0,0,8,6" />

                    <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                        Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button x:Name="MergeButton" Width="76" Height="26"
                            Margin="0,0,8,0" Click="Merge_Click">Merge</Button>
                        <Button Width="76" Height="26" IsCancel="True">Cancel</Button>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
