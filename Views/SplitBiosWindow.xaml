<Window x:Class="NexusProgrammer.SplitBiosWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Split BIOS" Width="520" Height="240" MinWidth="440" MinHeight="240"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResize"
    Background="{DynamicResource AppBackgroundBrush}"
    Foreground="{DynamicResource TextBrush}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TabControl VerticalAlignment="Stretch">
            <TabItem Header="Split BIOS">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="BIOS file"
                        VerticalAlignment="Center" />
                    <ComboBox x:Name="BiosCombo" Grid.Row="0" Grid.Column="1"
                        Grid.ColumnSpan="3" Height="24" Margin="0,0,0,6" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="File 1"
                        VerticalAlignment="Center" />
                    <TextBox x:Name="File1SizeBox" Grid.Row="1" Grid.Column="1"
                        Height="24" Margin="0,0,8,6" Text="8" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="MB"
                        VerticalAlignment="Center" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="File 2"
                        VerticalAlignment="Center" />
                    <TextBox x:Name="File2SizeBox" Grid.Row="2" Grid.Column="1"
                        Height="24" Margin="0,0,8,6" Text="16" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="MB"
                        VerticalAlignment="Center" />

                    <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                        Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button x:Name="SplitButton" Width="76" Height="26"
                            Margin="0,0,8,0" Click="Split_Click">Split</Button>
                        <Button Width="76" Height="26" IsCancel="True">Cancel</Button>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>