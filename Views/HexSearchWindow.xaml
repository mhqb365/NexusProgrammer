<Window x:Class="NexusProgrammer.HexSearchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Search" Width="520" Height="195"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    Background="{DynamicResource AppBackgroundBrush}"
    Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource ThemedButtonStyle}" />
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="42" />
        </Grid.RowDefinitions>

        <TabControl x:Name="ModeTabs" SelectionChanged="ModeTabs_SelectionChanged">
            <TabItem Header="Text" Tag="Text">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Search" VerticalAlignment="Center" />
                    <TextBox x:Name="TextQueryBox" Grid.Column="1" Height="24"
                        KeyDown="QueryBox_KeyDown" />
                </Grid>
            </TabItem>
            <TabItem Header="Hex" Tag="Hex">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Search" VerticalAlignment="Center" />
                    <TextBox x:Name="HexQueryBox" Grid.Column="1" Height="24"
                        KeyDown="QueryBox_KeyDown"
                        TextChanged="HexQueryBox_TextChanged" />
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1"
            Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="PreviousButton" Width="76" Height="26" Margin="0,0,8,0"
                Click="Previous_Click">Previous</Button>
            <Button x:Name="NextButton" Width="76" Height="26" Margin="0,0,8,0"
                Click="Next_Click">Next</Button>
            <Button x:Name="AllButton" Width="76" Height="26"
                Click="All_Click">All</Button>
        </StackPanel>
    </Grid>
</Window>
