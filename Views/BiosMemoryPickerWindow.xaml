<Window x:Class="NexusProgrammer.BiosMemoryPickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="BIOS Tool" Width="420" Height="320" MinWidth="360" MinHeight="260"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResize"
    Background="{DynamicResource AppBackgroundBrush}"
    Foreground="{DynamicResource TextBrush}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText" Grid.Row="0" Margin="0,0,0,8" />

        <ListBox x:Name="MemoryList" Grid.Row="1"
            SelectionMode="Extended"
            DisplayMemberPath="Label"
            Background="{DynamicResource SurfaceBackgroundBrush}"
            Foreground="{DynamicResource TextBrush}" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
            Margin="0,10,0,0">
            <Button x:Name="OkButton" Width="78" Height="26" Margin="0,0,8,0"
                IsDefault="True" Click="Ok_Click">OK</Button>
            <Button Width="78" Height="26" IsCancel="True">Cancel</Button>
        </StackPanel>
    </Grid>
</Window>
