<Window x:Class="NexusProgrammer.HexReplaceWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Replace" Width="560" Height="240"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    Background="{DynamicResource AppBackgroundBrush}"
    Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource ThemedButtonStyle}" />
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="42" />
        </Grid.RowDefinitions>

        <TabControl x:Name="ModeTabs" SelectionChanged="ModeTabs_SelectionChanged">
            <TabItem Header="Text" Tag="Text">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Search" VerticalAlignment="Center" />
                    <TextBox x:Name="TextSearchBox" Grid.Row="0" Grid.Column="1" Height="24" />
                    <TextBlock Grid.Row="1" Text="Replace" VerticalAlignment="Center" />
                    <TextBox x:Name="TextReplaceBox" Grid.Row="1" Grid.Column="1" Height="24"
                        KeyDown="ReplaceBox_KeyDown" />
                </Grid>
            </TabItem>
            <TabItem Header="Hex" Tag="Hex">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Search" VerticalAlignment="Center" />
                    <TextBox x:Name="HexSearchBox" Grid.Row="0" Grid.Column="1" Height="24"
                        TextChanged="HexBox_TextChanged" />
                    <TextBlock Grid.Row="1" Text="Replace" VerticalAlignment="Center" />
                    <TextBox x:Name="HexReplaceBox" Grid.Row="1" Grid.Column="1" Height="24"
                        TextChanged="HexBox_TextChanged"
                        KeyDown="ReplaceBox_KeyDown" />
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
            Margin="0,12,0,0">
            <Button x:Name="PreviousButton" Width="76" Height="26" Margin="0,0,8,0"
                Click="Previous_Click">Previous</Button>
            <Button x:Name="NextButton" Width="76" Height="26" Margin="0,0,8,0"
                Click="Next_Click">Next</Button>
            <Button x:Name="ReplaceAllButton" Width="76" Height="26"
                Click="ReplaceAll_Click">All</Button>
        </StackPanel>
    </Grid>
</Window>