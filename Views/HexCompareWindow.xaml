<Window x:Class="NexusProgrammer.HexCompareWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:NexusProgrammer"
    Title="Hex Compare" Height="660" MinHeight="660" Width="960" MinWidth="960"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResize"
    Background="{DynamicResource AppBackgroundBrush}"
    Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource ThemedButtonStyle}" />
    </Window.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="18" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Left" VerticalAlignment="Center"
                FontWeight="SemiBold" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="60" Height="24" Margin="0,0,4,0" Click="Search_Click">Search</Button>
                <Button Width="60" Height="24" Margin="0,0,12,0" Click="GoTo_Click">Go to</Button>
                <Button Width="64" Height="24" Margin="0,0,4,0" Click="FirstEqual_Click">First =</Button>
                <Button Width="64" Height="24" Margin="0,0,4,0" Click="PreviousEqual_Click">Prev =</Button>
                <Button Width="64" Height="24" Margin="0,0,4,0" Click="NextEqual_Click">Next =</Button>
                <Button Width="64" Height="24" Margin="0,0,12,0" Click="LastEqual_Click">Last =</Button>
                <Button Width="64" Height="24" Margin="0,0,4,0" Click="FirstDiff_Click">First ≠</Button>
                <Button Width="64" Height="24" Margin="0,0,4,0" Click="PreviousDiff_Click">Prev ≠</Button>
                <Button Width="64" Height="24" Margin="0,0,4,0" Click="NextDiff_Click">Next ≠</Button>
                <Button Width="64" Height="24" Click="LastDiff_Click">Last ≠</Button>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Grid.Column="0" Margin="0,0,6,4" BorderBrush="#A0A0A0"
            BorderThickness="1">
            <StackPanel>
                <TextBlock Text="File size" FontWeight="SemiBold" Background="#B8C7D6" Padding="4,1" />
                <TextBlock x:Name="FirstSizeHexText" Padding="12,1,4,0" FontFamily="Consolas" />
                <TextBlock Text="Offset" FontWeight="SemiBold" Background="#B8C7D6" Padding="4,1" />
                <TextBlock x:Name="FirstOffsetHexText" Padding="12,1,4,0" FontFamily="Consolas" />
                <TextBlock Text="Value" FontWeight="SemiBold" Background="#B8C7D6" Padding="4,1" />
                <TextBlock x:Name="FirstCharText" Padding="12,1,4,0" FontFamily="Consolas" />
                <TextBlock x:Name="FirstBitText" Padding="12,0,4,0" FontFamily="Consolas" />
                <TextBlock x:Name="FirstByteHexText" Padding="12,0,4,0" FontFamily="Consolas" />
                <TextBlock x:Name="FirstWordHexText" Padding="12,0,4,0" FontFamily="Consolas" />
                <TextBlock x:Name="FirstDwordHexText" Padding="12,0,4,0" FontFamily="Consolas" />
            </StackPanel>
        </Border>

        <GridSplitter Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Width="4"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#D0D0D0" />

        <GroupBox Grid.Row="1" Grid.Column="2"
            Header="{Binding FirstHeader, RelativeSource={RelativeSource AncestorType=Window}}"
            Margin="0,0,4,4">
            <local:HexCompareView x:Name="FirstView" />
        </GroupBox>

        <Border Grid.Row="2" Grid.Column="0" Margin="0,4,6,0" BorderBrush="#A0A0A0"
            BorderThickness="1">
            <StackPanel>
                <TextBlock Text="File size" FontWeight="SemiBold" Background="#B8C7D6" Padding="4,1" />
                <TextBlock x:Name="SecondSizeHexText" Padding="12,1,4,0" FontFamily="Consolas" />
                <TextBlock Text="Offset" FontWeight="SemiBold" Background="#B8C7D6" Padding="4,1" />
                <TextBlock x:Name="SecondOffsetHexText" Padding="12,1,4,0" FontFamily="Consolas" />
                <TextBlock Text="Value" FontWeight="SemiBold" Background="#B8C7D6" Padding="4,1" />
                <TextBlock x:Name="SecondCharText" Padding="12,1,4,0" FontFamily="Consolas" />
                <TextBlock x:Name="SecondBitText" Padding="12,0,4,0" FontFamily="Consolas" />
                <TextBlock x:Name="SecondByteHexText" Padding="12,0,4,0" FontFamily="Consolas" />
                <TextBlock x:Name="SecondWordHexText" Padding="12,0,4,0" FontFamily="Consolas" />
                <TextBlock x:Name="SecondDwordHexText" Padding="12,0,4,0" FontFamily="Consolas" />
            </StackPanel>
        </Border>

        <GroupBox Grid.Row="2" Grid.Column="2"
            Header="{Binding SecondHeader, RelativeSource={RelativeSource AncestorType=Window}}"
            Margin="0,4,4,0">
            <local:HexCompareView x:Name="SecondView" />
        </GroupBox>

        <ScrollBar x:Name="CompareScrollBar" Grid.Row="1" Grid.RowSpan="2" Grid.Column="3"
            Orientation="Vertical" ValueChanged="CompareScrollBar_ValueChanged" />

        <TextBlock x:Name="OffsetText" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4"
            VerticalAlignment="Center" />
    </Grid>
</Window>