<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>NexusProgrammer</AssemblyName>
    <Product>Nexus Programmer</Product>
    <Authors>mhqb365.com</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/mhqb365/NexusProgrammer</RepositoryUrl>
    <Version>1.1.3.13</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\icon.ico" />
    <Resource Include="Assets\icon.ico" />
    <Content Include="Assets\success.wav" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyMeaTools" AfterTargets="Build">
    <RemoveDir Directories="$(TargetDir)MEA" />
    <ItemGroup>
      <MeaToolFiles Include="$(MSBuildProjectDirectory)\MEA\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(MeaToolFiles)"
      DestinationFiles="@(MeaToolFiles->'$(TargetDir)MEA\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <Target Name="BuildIcCatalog" AfterTargets="Build">
    <Exec
      Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\tools\BuildCatalog.ps1&quot; -OutputPath &quot;$(TargetDir)ICCatalog.tsv&quot; -InputPath &quot;$(MSBuildProjectDirectory)\Catalog\CH34x_SPI_NOR.tsv;$(MSBuildProjectDirectory)\Catalog\XGecuT48_SPI_NOR.tsv;$(MSBuildProjectDirectory)\Catalog\User_SPI_NOR.tsv&quot;" />
  </Target>

  <ItemGroup>
    <Compile Remove="T48\**\*.cs" />
    <Compile Remove="SDK\**\*.cs" />
    <Compile Remove="tmp\**\*.cs" />
    <Page Remove="SDK\**\*.xaml" />
    <Page Remove="tmp\**\*.xaml" />
    <ApplicationDefinition Remove="SDK\**\*.xaml" />
    <ApplicationDefinition Remove="tmp\**\*.xaml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="SDK\T48.SDK\src\T48Sdk\T48.SDK.csproj" />
    <ProjectReference Include="SDK\RT809F.SDK\src\RT809F.SDK.csproj" />
    <ProjectReference Include="SDK\RT809H.SDK\src\RT809H.SDK.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MahApps.Metro.IconPacks.Lucide" Version="6.2.1" />
  </ItemGroup>

</Project>