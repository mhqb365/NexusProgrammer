<Window x:Class="NexusProgrammer.ClearMeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Clear ME" Width="620" Height="260"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    Background="{DynamicResource AppBackgroundBrush}"
    Foreground="{DynamicResource TextBrush}">
    <Grid Margin="10">
        <TabControl>
            <TabItem Header="Single BIOS">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="86" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="40" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="BIOS file"
                        VerticalAlignment="Center" />
                    <ComboBox x:Name="MemoryCombo" Grid.Row="0" Grid.Column="1"
                        Height="24" Margin="0,0,8,6" />
                    <Button x:Name="ClearMemoryButton" Grid.Row="0" Grid.Column="2"
                        Height="24" Margin="0,0,0,6" Click="ClearMemory_Click">X</Button>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="ME Region"
                        VerticalAlignment="Center" />
                    <ComboBox x:Name="MeRegionCombo" Grid.Row="1" Grid.Column="1"
                        Height="24" Margin="0,0,8,6" />
                    <Button Grid.Row="1" Grid.Column="2" Height="24" Margin="0,0,0,6"
                        Click="BrowseMeRegion_Click">Browse...</Button>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="FIT"
                        VerticalAlignment="Center" />
                    <ComboBox x:Name="FitCombo" Grid.Row="2" Grid.Column="1"
                        Height="24" Margin="0,0,8,6" />
                    <Button Grid.Row="2" Grid.Column="2" Height="24" Margin="0,0,0,6"
                        Click="BrowseFit_Click">Browse...</Button>

                    <Button x:Name="ClearMeButton" Grid.Row="3" Grid.Column="2"
                        Height="26" Margin="0,8,0,0" Click="ClearMe_Click">Clear ME</Button>
                </Grid>
            </TabItem>
            <TabItem Header="Dual BIOS">
                <Grid>
                    <TextBlock Text="Dual BIOS support will be added later."
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Foreground="{DynamicResource MutedTextBrush}" />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
